config.savemysaves.general.maxBackups=Max backups kept
config.savemysaves.general.maxBackups.comment=Maximum number of backups to keep (oldest are rolled out). Minimum 1
config.savemysaves.general.backupDirName=Backup directory name
config.savemysaves.general.backupDirName.comment=Name of the backup directory, relative to the world folder (start with an underscore so MC does not treat it as a save)
config.savemysaves.general.language=Message language
config.savemysaves.general.language.comment=Language for chat/command messages (rendered server-side, identical for all clients): zh_CN Simplified Chinese, en_US English
